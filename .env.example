# Copy to .env and fill in your own values. Do not commit the populated .env file.
# Public Expo variables are embedded in the app bundle, so do not treat them as secrets.
# Restrict and manage the Places API key in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Use a backend URL reachable from your device; local Expo Go development may use HTTP.
# Use HTTPS outside development.
EXPO_PUBLIC_API_BASE_URL=
